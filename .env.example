# Gmailブリッジ（Apps Script）から POST するときの共通秘密鍵
# 未設定なら認証なし（ローカル開発向け）
INGEST_SECRET=change-me-to-a-long-random-string

# Vercel Cron 認証（本番必須。Vercel が Authorization: Bearer を付与）
CRON_SECRET=change-me-cron-secret

# ---- Upstash Redis / Vercel KV（Vercel 本番で必須）----
# ローカルは未設定なら data/store.json に保存
KV_REST_API_URL=
KV_REST_API_TOKEN=
# または
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Slack ----
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=C0123456789

# ---- X API（@Takeroishi の Access Token / Secret を Developer Portal で発行）----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
